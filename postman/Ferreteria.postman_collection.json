{
  "info": {
    "name": "API Ferretería",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "CRUD de categorías y productos con login.\n1. Cambia la variable baseUrl por la IP del servidor.\n2. Ejecuta \"Registro inicial\" (solo la primera vez) o \"Login\": el token se guarda solo.\n3. Las demás peticiones usan ese token automáticamente."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Estado (¿falta registro inicial?)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/estado",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "estado"
              ]
            }
          }
        },
        {
          "name": "Registro inicial del ferretero",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.token) pm.collectionVariables.set(\"token\", d.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "registro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Don Pepe\",\n  \"correo\": \"pepe@ferreteria.com\",\n  \"password\": \"pepe123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.token) pm.collectionVariables.set(\"token\", d.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"pepe@ferreteria.com\",\n  \"password\": \"pepe123\"\n}"
            }
          }
        },
        {
          "name": "Mi usuario",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/yo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "yo"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Usuarios (solo admin)",
      "item": [
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            }
          }
        },
        {
          "name": "Crear empleado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana Rojas\",\n  \"correo\": \"ana@ferreteria.com\",\n  \"password\": \"ana123\",\n  \"rol\": \"empleado\"\n}"
            }
          }
        },
        {
          "name": "Eliminar usuario",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios/2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "2"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Categorías",
      "item": [
        {
          "name": "Listar categorías",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categorias",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categorias"
              ]
            }
          }
        },
        {
          "name": "Obtener categoría",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categorias/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categorias",
                "1"
              ]
            }
          }
        },
        {
          "name": "Productos de una categoría",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categorias/1/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categorias",
                "1",
                "productos"
              ]
            }
          }
        },
        {
          "name": "Crear categoría",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categorias",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categorias"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Jardinería\",\n  \"descripcion\": \"Palas, rastrillos y mangueras\"\n}"
            }
          }
        },
        {
          "name": "Actualizar categoría",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categorias/7",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categorias",
                "7"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Jardinería y riego\",\n  \"descripcion\": \"Palas, rastrillos, mangueras y aspersores\"\n}"
            }
          }
        },
        {
          "name": "Eliminar categoría (solo admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categorias/7",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categorias",
                "7"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ]
            }
          }
        },
        {
          "name": "Buscar productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos?buscar=llave",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ],
              "query": [
                {
                  "key": "buscar",
                  "value": "llave"
                }
              ]
            }
          }
        },
        {
          "name": "Filtrar por categoría",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos?categoria=2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ],
              "query": [
                {
                  "key": "categoria",
                  "value": "2"
                }
              ]
            }
          }
        },
        {
          "name": "Obtener producto",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos",
                "1"
              ]
            }
          }
        },
        {
          "name": "Crear producto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Serrucho 22\\\"\",\n  \"descripcion\": \"Dientes templados\",\n  \"precio\": 75,\n  \"stock\": 12,\n  \"id_categoria\": 1\n}"
            }
          }
        },
        {
          "name": "Actualizar producto",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/productos/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Martillo de uña 16 oz\",\n  \"descripcion\": \"Mango de fibra de vidrio\",\n  \"precio\": 48,\n  \"stock\": 28,\n  \"id_categoria\": 1\n}"
            }
          }
        },
        {
          "name": "Eliminar producto (solo admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/13",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos",
                "13"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Pruebas de error",
      "item": [
        {
          "name": "Sin token (401)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ]
            }
          }
        },
        {
          "name": "Login con contraseña incorrecta (401)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"pepe@ferreteria.com\",\n  \"password\": \"incorrecta\"\n}"
            }
          }
        },
        {
          "name": "Registro cuando ya existe el ferretero (403)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "registro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Otro\",\n  \"correo\": \"otro@ferreteria.com\",\n  \"password\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Producto con precio negativo (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Prueba\",\n  \"precio\": -5,\n  \"stock\": 1,\n  \"id_categoria\": 1\n}"
            }
          }
        },
        {
          "name": "Categoría inexistente (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Prueba\",\n  \"precio\": 5,\n  \"stock\": 1,\n  \"id_categoria\": 999\n}"
            }
          }
        },
        {
          "name": "Borrar categoría con productos (409)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categorias/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categorias",
                "1"
              ]
            }
          }
        },
        {
          "name": "Producto que no existe (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/9999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos",
                "9999"
              ]
            }
          }
        }
      ]
    }
  ]
}